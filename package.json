{
  "name": "ai-deslop",
  "version": "0.2.0",
  "description": "Opinionated Oxlint rules that reject low-evidence, low-signal, AI-slop code patterns.",
  "type": "module",
  "exports": "./src/index.ts",
  "files": [
    "src"
  ],
  "scripts": {
    "check": "oxlint src && tsc --noEmit",
    "lint": "oxlint src",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@oxlint/plugins": "1.82.0",
    "@tailwindcss/node": "^4.3.3",
    "synckit": "^0.11.13"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "oxlint": "1.82.0",
    "typescript": "7.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maharshi365/deslop.git"
  },
  "homepage": "https://github.com/maharshi365/deslop#readme",
  "bugs": {
    "url": "https://github.com/maharshi365/deslop/issues"
  },
  "keywords": [
    "oxlint",
    "oxlint-plugin",
    "eslint",
    "ai-slop",
    "code-quality",
    "typescript"
  ],
